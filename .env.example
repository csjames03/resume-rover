APP_NAME="Resume Rover"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=resume_rover
DB_USERNAME=resume_rover
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production. Requires HTTPS.
# SESSION_SECURE_COOKIE=true

# Set to false on a public deploy; grant admin with: php artisan users:admin you@example.com
REGISTRATION_ENABLED=true

# "*" behind a host's load balancer (Render); leave empty locally.
TRUSTED_PROXIES=

# Where résumé files are kept: local, or s3 (any S3-compatible bucket, e.g. Cloudflare R2).
RESUME_DISK=local

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers (optional). Any one key enables explanations and tailoring.
# Providers are tried in AI_PROVIDER_PRIORITY order and fail over automatically.
# Free tiers and model names change: check each provider's current terms.
AI_PROVIDER_PRIORITY=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REASONING_EFFORT=low
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI actions each account may start per rolling 24 hours (everyone shares the key above).
AI_USER_DAILY_LIMIT=30

# Gmail sending (optional). Create an OAuth client at console.cloud.google.com
# (see README). Authorized redirect URI: <APP_URL>/settings/email/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
